// External Functions Example
loadFile("Modelica/PackageA/package.mo"); getErrorString();
loadFile("Modelica/PackageB/package.mo"); getErrorString();
loadFile("Modelica/Example.mo"); getErrorString();

setCommandLineOptions("--baseModelica"); getErrorString();

writeFile("Base Modelica/Example.bmo", OpenModelica.Scripting.instantiateModel(Example));  getErrorString();

// External Objects Example
loadFile("Modelica/Multiplication/package.mo"); getErrorString();
loadFile("Modelica/ExternalObjectExample.mo"); getErrorString();

setCommandLineOptions("--baseModelica"); getErrorString();

writeFile("Base Modelica/ExternalObjectExample.bmo", OpenModelica.Scripting.instantiateModel(ExternalObjectExample)); getErrorString();
